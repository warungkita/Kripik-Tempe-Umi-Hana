# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode for the CRM & Analytics Dashboard.
# If left empty, the dashboard provides a one-time setup form on first visit.
ADMIN_PASSCODE=""

# WHATSAPP_API_TOKEN: Optional WhatsApp Cloud API / gateway token for automated webhook dispatch.
WHATSAPP_API_TOKEN=""

# WHATSAPP_PHONE_NUMBER_ID: Optional WhatsApp Business Phone Number ID.
WHATSAPP_PHONE_NUMBER_ID=""

# PAYMENT_WEBHOOK_SECRET: Optional webhook verification secret for external payment gateways.
PAYMENT_WEBHOOK_SECRET=""
